<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Header -->
    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Verify Document Information"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="24dp" />

    <!-- Instruction text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Please review the extracted information. Edit any fields if needed, then tap Confirm to continue."
        android:textSize="14sp"
        android:textColor="@color/gray"
        android:layout_marginBottom="16dp" />

    <!-- ScrollView for form fields -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Document Number -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Document Number"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/docNumEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter document number"
                android:inputType="text"
                android:padding="12dp"
                android:background="@drawable/edit_text_border"
                android:layout_marginBottom="16dp" />

            <!-- Date of Birth -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date of Birth (YYMMDD)"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/dobEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="YYMMDD (e.g., 290729)"
                android:inputType="number"
                android:padding="12dp"
                android:background="@drawable/edit_text_border"
                android:layout_marginBottom="16dp" />

            <!-- Expiry Date -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expiry Date (YYMMDD)"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/expiryEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="YYMMDD (e.g., 810409)"
                android:inputType="number"
                android:padding="12dp"
                android:background="@drawable/edit_text_border"
                android:layout_marginBottom="16dp" />

            <!-- CAN (optional) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CAN (optional)"
                android:textStyle="bold"
                android:textColor="@color/gray"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/canEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Card Access Number (optional)"
                android:inputType="text"
                android:padding="12dp"
                android:background="@drawable/edit_text_border"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Button container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/editButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Back to Camera"
            android:textColor="@color/primary_blue"
            android:background="@drawable/button_outline"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/confirmButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Confirm - Scan NFC"
            android:textColor="@color/white"
            android:background="@drawable/button_filled"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
