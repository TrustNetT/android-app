<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.trustnet.app">

    <!-- NFC Permissions -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />

    <!-- Camera Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrustNetApp">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- 
            CRITICAL: NFC intent filters REMOVED!
            
            Using NFCProgressActivity.enableReaderMode() instead (app-controlled, no intent interference).
            This gives NFCProgressActivity exclusive NFC control without Android sending intents to other activities.
            
            If we keep the intent filters below, Android will:
            1. Deliver TECH_DISCOVERED intent to MainActivity
            2. Launch MainActivity to foreground
            3. Pause NFCProgressActivity
            4. Activity loses focus → screen disappears
            5. Device NFC handler takes over
            
            With intent filters removed:
            - Only NFCProgressActivity gets NFC callbacks (via enableReaderMode)
            - No interference from Android's intent system
            - App has exclusive control for entire BAC + Phase 2 transaction
            -->
        </activity>

        <!-- Document Type Selection Activity -->
        <activity
            android:name=".DocumentTypeActivity"
            android:exported="false" />

        <!-- Camera Activity for capturing document and extracting CAN -->
        <activity
            android:name=".CameraActivity"
            android:exported="false" />

        <!-- Confirmation Activity for verifying and editing extracted MRZ data -->
        <activity
            android:name=".ConfirmationActivity"
            android:exported="false" />

        <!-- NFC Scanning Activity (uses app-controlled NfcAdapter.enableReaderMode) -->
        <activity
            android:name=".NFCProgressActivity"
            android:exported="false" />

        <!-- Passport Confirmation Activity (displays extracted data for user verification) -->
        <activity
            android:name=".PassportConfirmationActivity"
            android:exported="false" />

    </application>

</manifest>
